{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@catui/ai/stream": [
        "./packages/agent-core/src/upstream-stream.ts"
      ],
      "@catui/ai/*": [
        "./packages/agent-core/upstream/ai/*"
      ],
      "@catui/agent-core": [
        "./packages/agent-core/upstream/loop/types.ts"
      ]
    }
  },
  "include": [
    "apps",
    "packages"
  ],
  "exclude": [
    "packages/memory/upstream/extension.ts",
    "packages/memory/upstream/cli.ts"
  ]
}
